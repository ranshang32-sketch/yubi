<?xml version="1.0"?>
<robot name="demo_joint">
  <!-- 减速比 9:1 的准直驱关节：转子惯量 reflection + 摩擦 + 限位 -->
  <link name="base">
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.35"/>
      <inertia ixx="1.2e-4" ixy="0" ixz="0" iyy="1.3e-4" iyz="0" izz="9.0e-5"/>
    </inertial>
    <visual><geometry><cylinder radius="0.05" length="0.04"/></geometry></visual>
    <collision><geometry><cylinder radius="0.05" length="0.04"/></geometry></collision>
  </link>

  <link name="rotor">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="2.1e-5" ixy="0" ixz="0" iyy="2.1e-5" iyz="0" izz="1.8e-5"/>
    </inertial>
    <visual><geometry><mesh filename="link.stl" scale="1 1 1"/></geometry></visual>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base"/><child link="rotor"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.6" upper="2.6" effort="20" velocity="30"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <!-- 下面这些都是 URDF 里常见、但 MJCF 里没有对应物的东西 -->
  <transmission name="t1">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="joint1"><hardwareInterface>EffortJointInterface</hardwareInterface></joint>
    <actuator name="m1"><mechanicalReduction>9.0</mechanicalReduction></actuator>
  </transmission>
  <ros2_control name="Bus" type="system">
    <hardware><plugin>can_hardware/CanSystem</plugin></hardware>
    <joint name="joint1">
      <command_interface name="effort"/>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
