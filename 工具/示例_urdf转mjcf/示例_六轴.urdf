<?xml version="1.0"?>
<robot name="six_dof_demo">
  <link name="world"/>
  <link name="base_link">
    <inertial><origin xyz="0 0 0.03"/><mass value="2.5"/>
      <inertia ixx="0.012" ixy="0" ixz="0" iyy="0.013" iyz="0" izz="0.008"/></inertial>
    <collision><geometry><cylinder radius="0.08" length="0.06"/></geometry></collision>
  </link>
  <joint name="fixed_base" type="fixed">
    <parent link="world"/><child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="link1">
    <inertial><origin xyz="0 0 0.15"/><mass value="1.8"/>
      <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.0009"/></inertial>
  </link>
  <joint name="j1" type="revolute">
    <parent link="base_link"/><child link="link1"/>
    <origin xyz="0 0 0.06"/><axis xyz="0 0 1"/>
    <limit lower="-3.05" upper="3.05" effort="80" velocity="3.15"/>
    <dynamics damping="0.8" friction="0.3"/>
  </joint>

  <link name="link2">
    <inertial><origin xyz="0 0 0.13"/><mass value="1.4"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.0007"/></inertial>
  </link>
  <joint name="j2" type="revolute">
    <parent link="link1"/><child link="link2"/>
    <origin xyz="0 0 0.3" rpy="0 1.5708 0"/><axis xyz="0 0 1"/>
    <limit lower="-2.0" upper="2.0" effort="80" velocity="3.15"/>
    <dynamics damping="0.6" friction="0.25"/>
  </joint>

  <link name="link3">
    <inertial><origin xyz="0 0 0.10"/><mass value="1.1"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.0005"/></inertial>
  </link>
  <joint name="j3" type="revolute">
    <parent link="link2"/><child link="link3"/>
    <origin xyz="0 0 0.26"/><axis xyz="0 0 1"/>
    <limit lower="-2.8" upper="2.8" effort="40" velocity="3.15"/>
    <dynamics damping="0.4" friction="0.2"/>
  </joint>

  <transmission name="t1"><type>transmission_interface/SimpleTransmission</type>
    <joint name="j1"><hardwareInterface>EffortJointInterface</hardwareInterface></joint>
    <actuator name="m1"><mechanicalReduction>100</mechanicalReduction></actuator>
  </transmission>
  <transmission name="t2"><type>transmission_interface/SimpleTransmission</type>
    <joint name="j2"><hardwareInterface>EffortJointInterface</hardwareInterface></joint>
    <actuator name="m2"><mechanicalReduction>100</mechanicalReduction></actuator>
  </transmission>
</robot>
