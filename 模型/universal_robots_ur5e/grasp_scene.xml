<mujoco model="ur5e_grasp">
  <!--
    grasp_scene.xml —— 抓取演示场景（进阶教程 08 用）
    = UR5e + 自建二指夹爪（ur5e_gripper.xml）+ 工作台 + 待抓工件 + 放置区标记
    注意：含 include 的 XML 必须用 from_xml_path 加载，且场景文件要和模型同目录（教程 FAQ Q1）。
  -->
  <include file="ur5e_gripper.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <global azimuth="140" elevation="-20" offwidth="960" offheight="720"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>

  <worldbody>
    <light name="key_light" pos="0.6 -1.2 1.8" dir="0 0.4 -1" diffuse="0.75 0.75 0.75"/>
    <light name="fill_light" pos="-1.0 0.8 1.5" dir="0.4 -0.4 -1" diffuse="0.35 0.35 0.35"/>
    <geom name="floor" type="plane" size="2 2 0.05" rgba="0.30 0.33 0.38 1"/>

    <!-- 工作台：台面 z = 0.22 m -->
    <body name="worktable" pos="0.45 0 0.11">
      <geom name="table_top" type="box" size="0.20 0.25 0.11" rgba="0.62 0.58 0.52 1"
            friction="1.0 0.005 0.0001"/>
    </body>

    <!-- 待抓工件：30mm 立方体，自由体（能被夹爪抓走） -->
    <body name="part" pos="0.38 -0.06 0.235">
      <freejoint name="part_free"/>
      <geom name="part_geom" type="box" size="0.015 0.015 0.015" density="1500"
            friction="1.2 0.01 0.0001" condim="4" rgba="0.15 0.45 0.85 1"/>
    </body>

    <!-- 放置区标记：纯视觉（contype=0 不参与碰撞），表示"工件该放这儿" -->
    <geom name="place_pad" type="box" size="0.035 0.035 0.0015" pos="0.50 0.06 0.2215"
          contype="0" conaffinity="0" rgba="0.10 0.85 0.30 0.45"/>

    <!-- 演示相机（离屏录 GIF 用）：从右前方俯视整台设备 -->
    <camera name="demo_cam" pos="1.166 -0.706 0.694" xyaxes="0.7071 0.7071 0 -0.2534 0.2534 0.9336"/>
  </worldbody>
</mujoco>
