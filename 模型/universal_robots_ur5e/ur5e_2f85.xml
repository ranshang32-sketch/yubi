<mujoco model="ur5e">
  <!-- 编译期设置:
       angle="radian"   —— 本文件所有角度量(关节 range, keyframe qpos 等)都用弧度, 而非默认的 degree
       meshdir="assets" —— 网格文件目录, 相对于本 XML 所在路径, 即 assets/*.obj
       autolimits="true"—— 自动给 joint/actuator 补上 range 限制: 若写了 range 就自动置 limited="true",
                           没写 range 就自动置 limited="false"; 因此下文看不到显式 limited 属性 -->
  <compiler angle="radian" meshdir="assets/"/>

  <option impratio="10" integrator="implicitfast" cone="elliptic"/>

  <size nkey="1"/>

  <default>
    <default class="ur5e">
      <material shininess="0.25"/>
      <joint range="-6.28319 6.28319" armature="0.1" axis="0 1 0"/>
      <site size="0.001 0.005 0.005" group="4" rgba="0.5 0.5 0.5 0.3"/>
      <general ctrlrange="-6.2831 6.2831" forcerange="-150 150" biastype="affine" gainprm="2000" biasprm="0 -2000 -400"/>
      <default class="size3">
        <default class="size3_limited">
          <joint range="-3.1415 3.1415"/>
          <general ctrlrange="-3.1415 3.1415"/>
        </default>
      </default>
      <default class="size1">
        <general forcerange="-28 28" gainprm="500" biasprm="0 -500 -100"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom type="capsule" group="3"/>
        <default class="eef_collision">
          <geom type="cylinder"/>
        </default>
      </default>
    </default>
    <default class="gripper_main">
      <default class="gripper_2f85">
        <mesh scale="0.001 0.001 0.001"/>
        <joint axis="1 0 0"/>
        <general biastype="affine"/>
        <default class="gripper_driver">
          <joint solreflimit="0.005" solimplimit="0.95 0.99" range="0 0.8" armature="0.005" damping="0.1"/>
        </default>
        <default class="gripper_follower">
          <joint solreflimit="0.005" solimplimit="0.95 0.99" range="-0.872664 0.872664" armature="0.001" pos="0 -0.018 0.0065"/>
        </default>
        <default class="gripper_spring_link">
          <joint stiffness="0.05" range="-0.296706 0.8" springref="2.62" armature="0.001" damping="0.00125"/>
        </default>
        <default class="gripper_coupler">
          <joint solreflimit="0.005" solimplimit="0.95 0.99" range="-1.57 0" armature="0.001"/>
        </default>
        <default class="gripper_visual">
          <geom type="mesh" contype="0" conaffinity="0" group="2"/>
        </default>
        <default class="gripper_collision">
          <geom type="mesh" group="3"/>
          <default class="gripper_pad_box1">
            <geom size="0.011 0.004 0.009375" type="box" priority="1" friction="0.7" solref="0.004" solimp="0.95 0.99" rgba="0.55 0.55 0.55 1"/>
          </default>
          <default class="gripper_pad_box2">
            <geom size="0.011 0.004 0.009375" type="box" priority="1" friction="0.6" solref="0.004" solimp="0.95 0.99" rgba="0.45 0.45 0.45 1"/>
          </default>
        </default>
      </default>
    </default>
  </default>

